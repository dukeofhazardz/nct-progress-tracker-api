generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum DisputeStatus {
  PENDING
  RESOLVED
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  email        String?      @unique
  password     String
  name         String
  role         Role
  isActive     Boolean      @default(true)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  cohorts      Cohort[]     @relation("InstructorCohorts")
  memberships  Enrollment[]
  disputes     Dispute[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([departmentId, role])
}

model Department {
  id         String           @id @default(uuid())
  name       String           @unique
  users      User[]
  cohorts    Cohort[]
  curriculum CurriculumItem[]
  createdAt  DateTime         @default(now())
}

model CurriculumItem {
  id           String      @id @default(uuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  position     Int
  progress     Progress[]
  disputes     Dispute[]

  @@unique([departmentId, position])
  @@index([departmentId])
}

model Cohort {
  id           String       @id @default(uuid())
  name         String
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  instructorId String?
  instructor   User?        @relation("InstructorCohorts", fields: [instructorId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  progress     Progress[]
  disputes     Dispute[]
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@unique([departmentId, name])
  @@index([instructorId, isActive])
}

model Enrollment {
  id        String   @id @default(uuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cohortId, studentId])
  @@index([studentId])
}

model Progress {
  id               String         @id @default(uuid())
  cohortId         String
  cohort           Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  curriculumItemId String
  curriculumItem   CurriculumItem @relation(fields: [curriculumItemId], references: [id], onDelete: Cascade)
  completedAt      DateTime        @default(now())

  @@unique([cohortId, curriculumItemId])
  @@index([cohortId])
}

model Dispute {
  id               String         @id @default(uuid())
  studentId        String
  student          User           @relation(fields: [studentId], references: [id])
  cohortId         String
  cohort           Cohort         @relation(fields: [cohortId], references: [id])
  curriculumItemId String
  curriculumItem   CurriculumItem @relation(fields: [curriculumItemId], references: [id])
  reason           String
  status           DisputeStatus  @default(PENDING)
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())

  @@index([status, createdAt])
  @@index([studentId])
}
