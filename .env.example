DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@HOST:PORT/DATABASE_NAME"
JWT_SECRET="YOUR_SECRET_KEY"
ADMIN_USERNAME="ADMIN_USERNAME"
ADMIN_PASSWORD="ADMIN_PASSWORD"

# Profile pictures are stored in a public Supabase Storage bucket named `avatars`,
# not in the database. Without these two the app runs normally and every profile
# simply reports `avatarUrl: null` — only setting a picture is refused.
#
# SUPABASE_SERVICE_KEY is a full-access credential that bypasses row-level
# security, so it belongs here and nowhere else: never in a VITE_* variable, never
# in the frontend bundle. Prefer a secret key scoped to Storage if the project
# offers one.
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_KEY="YOUR_SERVICE_ROLE_KEY"
