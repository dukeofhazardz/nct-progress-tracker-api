// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Instructor {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String
  firstName    String?
  lastName     String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  cohorts      Cohort[]    @relation("InstructorCohorts")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([email])
}

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  cohorts     Cohort[]
  instructors Instructor[]
  curriculum  Curriculum[]
  syllabi     Syllabus[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model Cohort {
  id           String     @id @default(uuid())
  name         String     @unique
  instructorId String
  departmentId String
  instructor   Instructor @relation("InstructorCohorts", fields: [instructorId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([name])
}

model Curriculum {
  id           String     @id @default(uuid())
  name         String     @unique
  fileName     String
  fileType     String
  filePath     String
  uploadedBy   String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([name])
}

model Syllabus {
  id              String     @id @default(uuid())
  courseTitle     String
  difficultyLevel String
  durationWeeks   Int
  learningGoals   String[]
  content         Json
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([courseTitle])
}
