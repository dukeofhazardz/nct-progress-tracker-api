generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HOD
  INSTRUCTOR
  STUDENT
}

enum DisputeStatus {
  PENDING
  RESOLVED
}

/// Two different department relationships coexist deliberately:
///   - `User.departmentId` is the single department an INSTRUCTOR works in.
///     Cohort creation and assignment validation both depend on it.
///   - `DepartmentMember` is the set of departments a HOD heads, or a STUDENT
///     studies in. Both are many-to-many.
model User {
  id           String             @id @default(uuid())
  username     String             @unique
  email        String?            @unique
  password     String
  name         String
  role         Role
  isActive     Boolean            @default(true)
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  memberOf     DepartmentMember[]
  cohorts      Cohort[]           @relation("InstructorCohorts")
  memberships  Enrollment[]
  disputes     Dispute[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([email])
}

model Department {
  id         String             @id @default(uuid())
  name       String             @unique
  users      User[]
  members    DepartmentMember[]
  cohorts    Cohort[]
  curriculum CurriculumItem[]
  createdAt  DateTime           @default(now())
}

/// A HOD heading a department, or a student registered for one.
model DepartmentMember {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model CurriculumItem {
  id           String      @id @default(uuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  position     Int
  progress     Progress[]
  disputes     Dispute[]

  @@unique([departmentId, position])
  @@index([departmentId])
}

model Cohort {
  id           String     @id @default(uuid())
  name         String     @unique
  instructorId String
  departmentId String
  instructor   Instructor @relation("InstructorCohorts", fields: [instructorId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([name])
}

model Curriculum {
  id           String     @id @default(uuid())
  name         String     @unique
  fileName     String
  fileType     String
  filePath     String
  uploadedBy   String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([name])
}

model Syllabus {
  id              String     @id @default(uuid())
  courseTitle     String
  difficultyLevel String
  durationWeeks   Int
  learningGoals   String[]
  content         Json
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([courseTitle])
}
